# Copy to .env for local development. Production values come from Azure Key Vault.
RS_ENV=dev
RS_BASE_URL=http://localhost:8000
RS_SECRET_KEY=change-me-to-a-long-random-string
# 32 random bytes, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
RS_TOKEN_KEK=

RS_DATABASE_URL=sqlite+aiosqlite:///./var/reddysec.db
RS_ARTIFACTS_DIR=./var/artifacts

# Google OAuth client (Web application type). See docs/google-oauth-setup.md
RS_GOOGLE_CLIENT_ID=
RS_GOOGLE_CLIENT_SECRET=
RS_GOOGLE_PUBSUB_TOPIC=
RS_GMAIL_POLL_SECONDS=15

RS_SANDBOX_BACKEND=local
RS_DETONATION_TIMEOUT_S=45
RS_INTEL_ONLINE=false
RS_SAFE_BROWSING_API_KEY=

# Second-opinion language model: none | anthropic | azure_foundry | azure_openai
RS_LLM_PROVIDER=none
# Claude (Anthropic Messages API). Model ids: https://docs.claude.com/en/docs/about-claude/models
RS_ANTHROPIC_API_KEY=
RS_ANTHROPIC_MODEL=claude-haiku-4-5
# Azure AI Foundry model-inference endpoint (any deployed chat model)
RS_AZURE_FOUNDRY_ENDPOINT=
RS_AZURE_FOUNDRY_API_KEY=
RS_AZURE_FOUNDRY_MODEL=
# Azure OpenAI deployment
RS_AZURE_OPENAI_ENDPOINT=
RS_AZURE_OPENAI_API_KEY=
RS_AZURE_OPENAI_DEPLOYMENT=

RS_HOLD_DEAD_MAN_MINUTES=10
RS_HOLD_TIMEOUT_S=120

RS_DEV_LOGIN_ENABLED=true
