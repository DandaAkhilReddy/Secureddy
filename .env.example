# Copy to .env for local development. Production values come from Azure Key Vault.
RS_ENV=dev
RS_BASE_URL=http://localhost:8000
RS_SECRET_KEY=change-me-to-a-long-random-string
# 32 random bytes, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
RS_TOKEN_KEK=

RS_DATABASE_URL=sqlite+aiosqlite:///./var/reddysec.db
RS_ARTIFACTS_DIR=./var/artifacts

# Google OAuth client (Web application type). See docs/google-oauth-setup.md
RS_GOOGLE_CLIENT_ID=
RS_GOOGLE_CLIENT_SECRET=
RS_GOOGLE_PUBSUB_TOPIC=
# Sign in with Microsoft (Outlook.com, Hotmail, Microsoft 365 via Graph).
# Certificate auth: PEM bundle (private key + certificate) and its SHA-1 thumbprint.
RS_MICROSOFT_CLIENT_ID=
RS_MICROSOFT_CLIENT_CERT=
RS_MICROSOFT_CERT_THUMBPRINT=
# Sign in with Yahoo (sign-in only; Yahoo Mail connects with an app password)
RS_YAHOO_CLIENT_ID=
RS_YAHOO_CLIENT_SECRET=
RS_GMAIL_POLL_SECONDS=15

RS_SANDBOX_BACKEND=local
RS_DETONATION_TIMEOUT_S=45
RS_INTEL_ONLINE=false
RS_SAFE_BROWSING_API_KEY=

# Second-opinion language model: none | anthropic | azure_foundry | azure_openai
RS_LLM_PROVIDER=none
# Claude (Anthropic Messages API). Model ids: https://docs.claude.com/en/docs/about-claude/models
# Prefer keyless (Workload Identity Federation, below) in production; a static
# key is fine for local development.
RS_ANTHROPIC_API_KEY=
RS_ANTHROPIC_MODEL=claude-haiku-5-5
RS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Keyless Claude: identifiers from the Claude Console (docs/claude-keyless-setup.md).
# When the rule, organization and service account are set, the API key is not used.
RS_ANTHROPIC_FEDERATION_RULE_ID=
RS_ANTHROPIC_ORGANIZATION_ID=
RS_ANTHROPIC_SERVICE_ACCOUNT_ID=
RS_ANTHROPIC_WORKSPACE_ID=
# api://<Entra application id> the managed identity asks a token for
RS_ANTHROPIC_WIF_AUDIENCE=
# Client id of the user-assigned managed identity (empty = system-assigned)
RS_AZURE_IDENTITY_CLIENT_ID=

# "Ask Secureddy" in-app assistant: empty follows RS_LLM_PROVIDER
RS_ASSISTANT_PROVIDER=
# Empty uses the provider default (claude-sonnet-5-5 for Anthropic)
RS_ASSISTANT_MODEL=claude-sonnet-5-5
RS_ASSISTANT_MAX_TURNS=6
RS_ASSISTANT_DAILY_MESSAGE_LIMIT=200
# "Let the assistant read this email": most characters of one email sent
RS_ASSISTANT_READ_EMAIL_MAX_CHARS=6000
# Azure AI Foundry model-inference endpoint (any deployed chat model)
RS_AZURE_FOUNDRY_ENDPOINT=
RS_AZURE_FOUNDRY_API_KEY=
RS_AZURE_FOUNDRY_MODEL=
# Azure OpenAI deployment
RS_AZURE_OPENAI_ENDPOINT=
RS_AZURE_OPENAI_API_KEY=
RS_AZURE_OPENAI_DEPLOYMENT=

RS_HOLD_DEAD_MAN_MINUTES=10
RS_HOLD_TIMEOUT_S=120

# Stay signed in: a device's session slides forward with use and ends after
# this many idle days, or this many days after sign-in.
RS_SESSION_IDLE_DAYS=90
RS_SESSION_ABSOLUTE_DAYS=365
# Reading mail in Secureddy: "Load images" size cap, and how long a
# "Search inside emails" waits for each provider.
RS_IMAGE_PROXY_MAX_BYTES=5242880
RS_LIVE_SEARCH_TIMEOUT_S=8

# Who may open an account. Secureddy is free (no payments) and for a few people:
# at most RS_MAX_USERS accounts. invite_only: a new account needs an invite for
# its verified email (Admin -> People, or `reddysec invite <email>`); open:
# anyone may sign up (self-hosters), still capped. Existing accounts are never
# locked out. While nobody is an admin, the account with
# RS_BOOTSTRAP_ADMIN_EMAIL becomes one at sign-in.
RS_MAX_USERS=5
RS_SIGNUP_MODE=invite_only
RS_BOOTSTRAP_ADMIN_EMAIL=

RS_DEV_LOGIN_ENABLED=true
